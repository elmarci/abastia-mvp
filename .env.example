# Conexión a PostgreSQL (Neon). Usa la cadena "pooled" para DATABASE_URL
DATABASE_URL="postgresql://usuario:clave@ep-xxxx-pooler.region.aws.neon.tech/abastia?sslmode=require"
# Conexión directa (sin pooling) para migraciones de Prisma
DIRECT_URL="postgresql://usuario:clave@ep-xxxx.region.aws.neon.tech/abastia?sslmode=require"
# Genera uno con: npx auth secret
AUTH_SECRET="cambia-esto"
# Necesario fuera de Vercel (por ejemplo, en local con pnpm start)
AUTH_TRUST_HOST=true
# Opcional: protege el cron de Vercel (/api/cron)
CRON_SECRET=""
# Opcional: si existe, el asistente usa la API de Claude con tool use
ANTHROPIC_API_KEY=""
