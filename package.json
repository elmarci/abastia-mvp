    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.1.1"
